{
  "name": "masothue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:tncn": "tsx --test lib/tools/pit.test.ts",
    "test:mst": "tsx --test lib/tools/mst.test.ts",
    "test:late-payment": "tsx --test lib/tools/late-payment.test.ts",
    "test:overtime": "tsx --test lib/tools/overtime.test.ts",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:generate": "prisma generate",
    "pipeline:probe-esgoo": "tsx pipeline/scripts/probe-esgoo.ts",
    "pipeline:enrich-sample": "dotenv -e .env.local -- tsx pipeline/scripts/enrich-sample.ts",
    "pipeline:seed-sitemap": "dotenv -e .env.local -- tsx pipeline/scripts/seed-sitemap.ts",
    "pipeline:enrich-backfill": "dotenv -e .env.local -- tsx pipeline/scripts/enrich-backfill.ts",
    "pipeline:enrich-batch": "dotenv -e .env.local -- tsx pipeline/scripts/enrich-batch.ts",
    "pipeline:backfill-province": "dotenv -e .env.local -- tsx pipeline/scripts/backfill-province.ts",
    "pipeline:import-opendata": "dotenv -e .env.local -- tsx pipeline/scripts/import-opendata.ts",
    "test:directory": "tsx --test lib/directory/directory.test.ts",
    "test:notify": "tsx --test lib/notify/telegram.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}
