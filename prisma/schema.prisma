// Company data is PUBLIC business data only.
// Never add personal identifiers: phone, email, CCCD/CMND, etc.
// Exception: RemovalRequest keeps the requester's contact email; it is never shown on the site.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String       @id @default(cuid())
  taxCode            String       @unique
  name               String? // null for tax codes not yet enriched
  nameForeign        String?
  nameShort          String?
  address            String?
  province           String? // display name from pipeline/province.ts catalog, e.g. "TP. Hà Nội"
  provinceSlug       String? // catalog slug, e.g. "ha-noi"
  district           String?
  ward               String?
  status             String? // null when the source does not report it
  activeDate         DateTime?    @db.Date
  legalType          String?
  taxOffice          String?
  representativeName String?
  mainIndustryCode   String?
  mainIndustry       String?
  latitude           Float?
  longitude          Float?
  capital            Decimal?     @db.Decimal(20, 0)
  enrichStatus       EnrichStatus @default(PENDING)
  lastEnrichedAt     DateTime?
  isHidden           Boolean      @default(false) // true = 404 and left out of every list/sitemap
  dataSource         String? // bulk-import origin, e.g. "opendata-hcm" (pipeline/scripts/import-opendata.ts)
  dataAsOf           DateTime?    @db.Date // "last updated" date of that dataset on the publisher's portal
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  industries CompanyIndustry[]
  changes    CompanyChange[]

  @@index([provinceSlug])
  @@index([status])
  @@index([enrichStatus])
}

// SOURCE_MISS = the queried source had no data for this tax code.
// It does NOT mean the company doesn't exist; retry with another source.
enum EnrichStatus {
  PENDING
  OK
  SOURCE_MISS
}

model CompanyIndustry {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  isPrimary Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([code])
}

model CompanyChange {
  id        String   @id @default(cuid())
  companyId String
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  source    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, changedAt])
}

// Filed from /yeu-cau-go-thong-tin. Reviewed by hand; a request never hides a company by itself.
model RemovalRequest {
  id                String             @id @default(cuid())
  taxCode           String
  reason            String             @db.Text
  contactEmail      String
  requesterName     String?
  requesterRelation RequesterRelation?
  status            RemovalStatus      @default(PENDING)
  createdAt         DateTime           @default(now())

  @@index([status, createdAt])
  @@index([taxCode])
}

enum RequesterRelation {
  OWNER
  REPRESENTATIVE
  OTHER
}

enum RemovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Province catalog lives in code: pipeline/province.ts (34 units, slug-keyed).

model IngestCheckpoint {
  id        String   @id @default(cuid())
  scope     String   @unique // e.g. province code
  cursor    String?
  page      Int      @default(0)
  status    String   @default("pending") // pending | running | done | failed
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Directory (danh bạ). Businesses submit their own profile; an admin approves it by hand.
// submitter_* and ip_hash are private: never selected by any public read (lib/directory).
// Extra CHECK constraints live in the migration SQL only.

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SponsorLeadStatus {
  NEW
  CALLED
  WON
  LOST
}

model ProfileSubmission {
  id                  String           @id
  mst                 String
  companyName         String           @map("company_name")
  address             String
  provinceSlug        String           @map("province_slug")
  groupSlug           String           @map("group_slug")
  description         String           @db.VarChar(300)
  services            Json             @default("[]")
  publicPhone         String?          @map("public_phone")
  publicZalo          String?          @map("public_zalo")
  website             String?
  publicEmail         String?          @map("public_email")
  consentPublish      Boolean          @map("consent_publish")
  submitterName       String           @map("submitter_name")
  submitterRole       String           @map("submitter_role")
  submitterPhone      String           @map("submitter_phone")
  confirmAuthority    Boolean          @map("confirm_authority")
  status              SubmissionStatus @default(PENDING)
  rejectReason        String?          @map("reject_reason")
  ipHash              String           @map("ip_hash")
  nameMatchesRegistry Boolean?         @map("name_matches_registry")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt          DateTime?        @map("reviewed_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([mst])
  @@index([ipHash, createdAt])
  @@map("profile_submission")
}

model BusinessProfile {
  mst                String   @id
  companyName        String   @map("company_name")
  address            String
  provinceSlug       String   @map("province_slug")
  groupSlug          String   @map("group_slug")
  description        String   @db.VarChar(300)
  services           Json     @default("[]")
  publicPhone        String?  @map("public_phone")
  publicZalo         String?  @map("public_zalo")
  website            String?
  publicEmail        String?  @map("public_email")
  logoUrl            String?  @map("logo_url")
  sourceSubmissionId String   @map("source_submission_id")
  approvedAt         DateTime @map("approved_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([groupSlug, provinceSlug])
  @@map("business_profile")
}

// Paid "Đứng đầu ngành" slots, entered by the admin. No overlap per group+province+position (checked in code).
model FeaturedPlacement {
  id           String   @id
  mst          String
  groupSlug    String   @map("group_slug")
  provinceSlug String   @map("province_slug")
  position     Int      @db.SmallInt
  startsAt     DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(3)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([groupSlug, provinceSlug, position])
  @@map("featured_placement")
}

model SponsorLead {
  id           String            @id
  contactName  String            @map("contact_name")
  phone        String
  mst          String?
  groupSlug    String            @map("group_slug")
  provinceSlug String            @map("province_slug")
  message      String?
  status       SponsorLeadStatus @default(NEW)
  ipHash       String            @map("ip_hash")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("sponsor_lead")
}
