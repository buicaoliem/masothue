// PUBLIC business data only.
// Never add personal identifiers: phone, email, CCCD/CMND, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String       @id @default(cuid())
  taxCode            String       @unique
  name               String? // null for tax codes not yet enriched
  nameForeign        String?
  nameShort          String?
  address            String?
  province           String? // display name from pipeline/province.ts catalog, e.g. "TP. Hà Nội"
  provinceSlug       String? // catalog slug, e.g. "ha-noi"
  district           String?
  ward               String?
  status             String? // null when the source does not report it
  activeDate         DateTime?    @db.Date
  legalType          String?
  taxOffice          String?
  representativeName String?
  mainIndustryCode   String?
  mainIndustry       String?
  latitude           Float?
  longitude          Float?
  capital            Decimal?     @db.Decimal(20, 0)
  enrichStatus       EnrichStatus @default(PENDING)
  lastEnrichedAt     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  industries CompanyIndustry[]
  changes    CompanyChange[]

  @@index([provinceSlug])
  @@index([status])
  @@index([enrichStatus])
}

// SOURCE_MISS = the queried source had no data for this tax code.
// It does NOT mean the company doesn't exist; retry with another source.
enum EnrichStatus {
  PENDING
  OK
  SOURCE_MISS
}

model CompanyIndustry {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  isPrimary Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([code])
}

model CompanyChange {
  id        String   @id @default(cuid())
  companyId String
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  source    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, changedAt])
}

// Province catalog lives in code: pipeline/province.ts (34 units, slug-keyed).

model IngestCheckpoint {
  id        String   @id @default(cuid())
  scope     String   @unique // e.g. province code
  cursor    String?
  page      Int      @default(0)
  status    String   @default("pending") // pending | running | done | failed
  updatedAt DateTime @updatedAt
}
